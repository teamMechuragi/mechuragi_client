{
  "expo": {
    "name": "moblie",
    "slug": "moblie",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "myapp",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splashBG.png",
      "resizeMode": "contain",
      "backgroundColor": "#ffffff"
    },
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.mechuragi.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/splashBG.png",
        "backgroundColor": "#ffffff"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/splashBG.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "메추라기가 갤러리에 접근하려고 합니다.",
          "cameraPermission": "메추라기가 카메라를 사용하려고 합니다."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}